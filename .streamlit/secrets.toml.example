# Veridicta — Streamlit Cloud secrets template
# Copy this file content into: Streamlit Cloud > App settings > Secrets
# Do NOT commit .streamlit/secrets.toml (already gitignored)

# Cerebras Cloud API key — https://cloud.cerebras.ai
CEREBRAS_API_KEY = "csk-..."

# GitHub PAT for Copilot backend (optional — only needed if LLM_BACKEND=copilot)
GITHUB_PAT = "github_pat_..."

# HuggingFace token (read access) — https://huggingface.co/settings/tokens
# Required to download the index artifacts from Fascinax/veridicta-index
HF_API_TOKEN = "hf_..."

# Optional overrides
# LLM_BACKEND = "cerebras"   # or "copilot"
# COPILOT_MODEL = "claude-sonnet-5.5"
# LLM_MODEL   = "gpt-oss-120b"

# Private hosting: stop access until an OIDC provider and an explicit policy exist.
VERIDICTA_WORKSPACE_MODE = "authenticated"
VERIDICTA_ACCESS_POLICY_FILE = "/run/veridicta/access-policy.json"
# All workers on one host must share a private database on local storage.
# VERIDICTA_REQUEST_LIMITS_DB = "/run/veridicta/runtime/request-limits.sqlite3"

# Register this client with your provider, then replace every placeholder privately.
# Use one default provider in this template; never expose tokens to the app.
# [auth]
# redirect_uri = "https://your-app.example.invalid/oauth2callback"
# cookie_secret = "REPLACE_WITH_A_RANDOM_PRIVATE_VALUE"
# client_id = "REPLACE_WITH_THE_REGISTERED_CLIENT_ID"
# client_secret = "REPLACE_WITH_THE_PRIVATE_CLIENT_SECRET"
# server_metadata_url = "https://your-idp.example.invalid/.well-known/openid-configuration"
