# Veridicta - Configuration
# Copier ce fichier vers .env et remplir les valeurs

# ---------- LLM Backend ----------
# "copilot" (default), "cerebras" (Cerebras Cloud) ou "omniroute" (gateway local)
LLM_BACKEND=copilot

# --- GitHub Copilot (si LLM_BACKEND=copilot) ---
# PAT avec scope `copilot`, ou `gh auth login` en fallback
GITHUB_PAT=
COPILOT_MODEL=gpt-4.1

# --- Cerebras ---
CEREBRAS_API_KEY=

# --- OmniRoute (si LLM_BACKEND=omniroute) ---
# Installer et lancer OmniRoute séparément : npm install -g omniroute && omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Même clé gateway que dans OmniRoute si l'authentification API est activée
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# ---------- Scraping ----------
SCRAPE_DELAY_SECONDS=1.0
